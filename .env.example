# =============================================
# Variables d'environnement — Docker Compose
# Ce fichier est lu automatiquement par Docker Compose.
# Les valeurs sensibles (mots de passe, secrets) ne doivent
# pas être committées en production — utiliser .env.local.
# =============================================

# ---- Symfony ----

# Environnement applicatif (dev | prod | test)
APP_ENV=

# Clé secrète utilisée par Symfony pour signer les tokens CSRF, sessions, etc.
APP_SECRET=

# URL de connexion à la base de données MySQL (host = nom du container Docker)
DATABASE_URL=

# Regex des origines autorisées pour les requêtes CORS (React tourne sur localhost:5173)
CORS_ALLOW_ORIGIN=

# Passphrase utilisée pour chiffrer la clé privée JWT
JWT_PASSPHRASE=

# ---- MySQL ----

# Nom de la base de données créée au démarrage du container MySQL
MYSQL_DATABASE=

# Mot de passe root MySQL
MYSQL_ROOT_PASSWORD=
